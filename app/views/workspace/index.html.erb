<% html_title(l(:label_workspace)) %>
<% user = User.current %>
<% unread = @space.unread_count %>

<div class="gf-page gf-myspace">
  <header class="gf-page-header">
    <div>
      <h2><%= workspace_greeting(user) %></h2>
      <p class="gf-muted">
        <%= format_date(user.today) %>
        <% if @space.summary['overdue'] > 0 %>
          · <%= link_to l(:label_workspace_summary_overdue, count: @space.summary['overdue']), workspace_search_path(q: 'moi retard'), class: 'gf-overdue' %>
        <% end %>
        <% if @space.summary['week'] > 0 %>
          · <%= link_to l(:label_workspace_summary_week, count: @space.summary['week']), workspace_search_path(q: 'moi semaine'), class: 'gf-due-soon' %>
        <% end %>
      </p>
    </div>
    <div class="gf-page-actions">
      <% if user.allowed_to?(:add_issues, nil, global: true) %>
        <%= link_to sprite_icon('add', l(:label_issue_new)), new_issue_path, class: 'gf-button gf-button-primary' %>
      <% end %>
    </div>
  </header>

  <nav class="gf-tabs" aria-label="<%= l(:label_workspace_my_issues) %>">
    <% RedmineWorkspace::MySpace::TABS.each do |tab| %>
      <%= link_to workspace_path(tab: tab), class: (tab == @tab ? 'selected' : nil), 'aria-current': (tab == @tab ? 'page' : nil) do %>
        <%= l("label_workspace_tab_#{tab}") %> <span class="gf-tab-count"><%= @space.tab_counts[tab] %></span>
      <% end %>
    <% end %>
    <%= link_to workspace_path(tab: 'activity'), class: ('selected' if @tab == 'activity'), 'aria-current': ('page' if @tab == 'activity') do %>
      <%= l(:label_workspace_tab_activity) %>
      <% if unread > 0 %><span class="gf-tab-badge"><%= l(:label_workspace_new_count, count: unread) %></span><% end %>
    <% end %>
  </nav>

  <% if @tab == 'activity' %>
    <section class="gf-inbox-section" aria-label="<%= l(:label_workspace_tab_activity) %>">
      <div class="gf-inbox-head">
        <p class="gf-muted gf-small"><%= unread > 0 ? l(:label_workspace_inbox_unread, count: unread) : l(:label_workspace_inbox_all_read) %></p>
        <% if unread > 0 %>
          <%= button_to l(:label_workspace_mark_all_read), workspace_mark_all_read_path, class: 'gf-button', form_class: 'gf-inline-form' %>
        <% end %>
      </div>
      <% if @space.inbox.empty? %>
        <p class="gf-empty"><%= l(:text_workspace_no_activity) %></p>
      <% else %>
        <ul class="gf-inbox">
          <% @space.inbox.each do |entry| %>
            <% issue = entry.issue %>
            <% latest = entry.latest %>
            <li class="gf-inbox-item<%= ' unread' if entry.unread? %>">
              <%= link_to issue_path(issue, anchor: "change-#{latest.id}"), class: 'gf-inbox-link' do %>
                <span class="gf-unread-dot" aria-hidden="true"></span>
                <% if entry.unread? %><span class="gf-visually-hidden"><%= l(:label_workspace_unread) %></span><% end %>
                <%= avatar(latest.user, size: 24) %>
                <span class="gf-inbox-text">
                  <span class="gf-inbox-title">
                    <span class="gf-issue-id">#<%= issue.id %></span>
                    <span class="gf-inbox-subject"><%= issue.subject %></span>
                    <span class="gf-issue-project"><%= workspace_project_dot(issue.project) %><%= issue.project %></span>
                  </span>
                  <span class="gf-inbox-change"><%= workspace_journal_line(latest) %></span>
                </span>
                <span class="gf-inbox-meta">
                  <span><%= l(:label_workspace_ago, time: distance_of_time_in_words(Time.now, latest.created_on)) %></span>
                  <% if entry.journals.size > 1 %>
                    <span><%= l(:label_workspace_changes_count, count: entry.journals.size) %></span>
                  <% end %>
                </span>
              <% end %>
              <%= workspace_peek_button(issue) %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% elsif @issues.empty? %>
    <p class="gf-empty"><%= l("text_workspace_empty_#{@tab}") %></p>
  <% else %>
    <% groups = @tab == 'assigned' ? @space.grouped(@issues) : [[nil, @issues]] %>
    <% groups.each do |bucket, issues| %>
      <details class="gf-issue-group" <%= 'open' unless bucket == 'none' && groups.size > 1 %>>
        <% if bucket %>
          <summary class="gf-group-title gf-bucket-<%= bucket %>">
            <%= workspace_bucket_label(bucket) %> <span class="gf-group-count"><%= issues.size %></span>
          </summary>
        <% else %>
          <summary class="gf-visually-hidden"><%= l("label_workspace_tab_#{@tab}") %></summary>
        <% end %>
        <ul class="gf-issue-rows">
          <% issues.each do |issue| %>
            <li class="gf-issue-item">
              <%= link_to issue_path(issue), class: "gf-issue-row #{issue.css_classes}" do %>
                <%= workspace_priority_tag(issue.priority, label: false) %>
                <span class="gf-issue-id">#<%= issue.id %></span>
                <span class="gf-issue-subject"><%= issue.subject %></span>
                <span class="gf-issue-project"><%= workspace_project_dot(issue.project) %><%= issue.project %></span>
                <%= workspace_status_tag(issue.status) %>
                <%= workspace_due_tag(issue) %>
              <% end %>
              <%= workspace_peek_button(issue) %>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
    <% if @space.tab_counts[@tab] > @issues.size %>
      <p class="gf-more"><%= workspace_search_link({'assigned' => 'moi', 'created' => 'auteur:moi', 'watched' => 'suivi'}[@tab], l(:label_workspace_see_all, count: @space.tab_counts[@tab])) %></p>
    <% end %>
  <% end %>
</div>
