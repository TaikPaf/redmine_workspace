<% if User.current.logged? && issue.persisted? && issue.attributes_editable? %>
<div id="gf-inline" hidden
     data-url="<%= workspace_issue_inline_path(issue) %>"
     data-i18n="<%= {
       edit: l(:label_workspace_inline_edit),
       none: l(:label_none),
       error: l(:error_workspace_inline_failed),
       saving: l(:label_workspace_inline_saving)
     }.to_json %>"></div>
<% targets = issue.new_statuses_allowed_to(User.current) - [issue.status] %>
<% if targets.any? %>
<div class="gf-transitions" role="group" aria-label="<%= l(:label_workspace_move_to) %>">
  <span class="gf-muted gf-small"><%= l(:label_workspace_move_to) %></span>
  <% targets.each do |status| %>
    <%= form_tag(issue_path(issue), method: :patch, class: 'gf-transition-form') do %>
      <%= hidden_field_tag 'issue[status_id]', status.id, id: nil %>
      <%= hidden_field_tag 'issue[lock_version]', issue.lock_version, id: nil %>
      <%= hidden_field_tag 'last_journal_id', issue.last_journal_id, id: nil %>
      <button type="submit" class="gf-transition<%= ' gf-transition-closed' if status.is_closed? %>"><%= status.name %></button>
    <% end %>
  <% end %>
</div>
<% end %>
<% end %>
