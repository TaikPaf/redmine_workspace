<% if User.current.logged? && issue.persisted? %>
<% if issue.attributes_editable? %>
<div id="gf-inline" hidden
     data-url="<%= workspace_issue_inline_path(issue) %>"
     data-i18n="<%= {
       edit: l(:label_workspace_inline_edit),
       none: l(:label_none),
       error: l(:error_workspace_inline_failed),
       saving: l(:label_workspace_inline_saving)
     }.to_json %>"></div>
<% targets = issue.new_statuses_allowed_to(User.current) - [issue.status] %>
<% if targets.any? %>
<div class="gf-transitions" role="group" aria-label="<%= l(:label_workspace_move_to) %>">
  <span class="gf-muted gf-small"><%= l(:label_workspace_move_to) %></span>
  <% targets.each do |status| %>
    <%= form_tag(issue_path(issue), method: :patch, class: 'gf-transition-form') do %>
      <%= hidden_field_tag 'issue[status_id]', status.id, id: nil %>
      <%= hidden_field_tag 'issue[lock_version]', issue.lock_version, id: nil %>
      <%= hidden_field_tag 'last_journal_id', issue.last_journal_id, id: nil %>
      <button type="submit" class="gf-transition<%= ' gf-transition-closed' if status.is_closed? %>"><%= status.name %></button>
    <% end %>
  <% end %>
</div>
<% end %>
<% end %>
<% if issue.notes_addable? %>
  <%# Rendered inside the attributes block by the hook; workspace.js moves it under the history. %>
  <%= form_tag(workspace_issue_notes_path(issue), method: :post, class: 'gf-note-composer', hidden: true) do %>
    <%= avatar(User.current, size: 28) %>
    <div class="gf-peek-note-form">
      <label class="gf-visually-hidden" for="gf-composer-note"><%= l(:label_workspace_add_note) %></label>
      <textarea id="gf-composer-note" name="notes" rows="3" placeholder="<%= l(:label_workspace_add_note) %>…"></textarea>
      <div class="gf-peek-note-actions">
        <% if User.current.allowed_to?(:set_notes_private, issue.project) %>
          <label class="gf-small gf-muted"><input type="checkbox" name="private_notes" value="1"> <%= l(:field_private_notes) %></label>
        <% end %>
        <span class="gf-small gf-muted"><%= l(:label_workspace_ctrl_enter) %></span>
        <button type="submit" class="gf-button gf-button-primary"><%= l(:button_submit) %></button>
      </div>
    </div>
  <% end %>
<% end %>
<% end %>
