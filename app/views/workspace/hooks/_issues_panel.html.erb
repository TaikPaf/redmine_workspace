<% if User.current.logged? %>
<% text = params[:gf_q].to_s %>
<% parsed = text.present? ? RedmineWorkspace::SearchParser.new(project: project).parse(text) : nil %>
<% views = RedmineWorkspace::QuickViews.for(project) %>
<section id="gf-issues-panel" class="gf-issues-panel" aria-label="<%= l(:label_workspace_quick_search) %>">
  <div class="gf-chips" role="group" aria-label="<%= l(:label_workspace_quick_views) %>">
    <% views.each do |view| %>
      <% active = text.strip == view.text %>
      <%= link_to workspace_search_path(q: view.text, project_id: project&.id), class: "gf-chip#{' active' if active}", 'aria-current': (active ? 'true' : nil) do %>
        <%= view.label %> <span class="gf-count"><%= view.count %></span>
      <% end %>
    <% end %>
    <% saved = IssueQuery.visible.global_or_on_project(project).sorted.limit(10).to_a %>
    <% if saved.any? %>
      <span class="gf-chips-separator" role="separator" aria-label="<%= l(:label_workspace_saved_views) %>"></span>
      <% saved.each do |query| %>
        <% active = params[:query_id].to_s == query.id.to_s %>
        <%= link_to _project_issues_path(project, query_id: query.id), class: "gf-chip gf-chip-saved#{' active' if active}", 'aria-current': (active ? 'true' : nil) do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>
          <%= query.name %>
        <% end %>
      <% end %>
    <% end %>
    <% if User.current.allowed_to?(:save_queries, project, global: true) %>
      <button type="button" class="gf-chip gf-chip-add" data-gf-save-view>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <%= l(:label_workspace_save_view) %>
      </button>
    <% end %>
  </div>
  <%= form_tag(workspace_search_path, method: :get, class: 'gf-smart-search') do %>
    <%= hidden_field_tag 'project_id', project&.id, id: nil %>
    <label class="gf-search-field gf-search-large">
      <span class="gf-visually-hidden"><%= l(:label_workspace_quick_search) %></span>
      <%= sprite_icon('search', icon_only: true) %>
      <%= text_field_tag 'q', text, id: 'gf-smart-q', placeholder: l(:label_workspace_search_placeholder), autocomplete: 'off' %>
    </label>
    <button type="button" class="gf-button gf-query-toggle" data-gf-query-pane="filters" aria-expanded="false" aria-controls="query_form">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18l-7 8.5V19l-4 2v-7.5z"/></svg>
      <%= l(:label_workspace_filters) %> <span class="gf-tab-badge" data-gf-filter-count hidden></span>
    </button>
    <button type="button" class="gf-button gf-query-toggle" data-gf-query-pane="options" aria-expanded="false" aria-controls="query_form">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg>
      <%= l(:label_workspace_display) %>
    </button>
  <% end %>
  <div class="gf-understood">
    <span class="gf-muted gf-small"><%= l(:label_workspace_understood) %></span>
    <% if parsed.nil? || parsed.tokens.empty? %>
      <span class="gf-muted gf-small"><%= parsed ? l(:label_workspace_token_open_default) : l(:text_workspace_search_help) %></span>
    <% else %>
      <% parsed.tokens.each do |token| %>
        <% remaining = text.sub(token.raw, '').squeeze(' ').strip %>
        <span class="gf-token">
          <%= token.label %>
          <%= link_to workspace_search_path(q: remaining, project_id: project&.id), class: 'gf-token-remove', 'aria-label': l(:label_workspace_remove_token, label: token.label) do %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          <% end %>
        </span>
      <% end %>
    <% end %>
  </div>
</section>
<% end %>
